{
  "version": 1,
  "name": "Trapezoid pulse: 2D ZY vacuum drift",
  "description": "Trapezoid sheet-beam pulse (half-width R = 1.5 mm, 1 keV) drifting through a grounded 15 mm gap; y = 0 is a symmetry plane. Emission: uniform-flux waterbag normal speed v_b-2e5 ... v_b+2e5 m/s and a transverse waterbag of half-width 2e5 m/s. J(t): rise 0.06 ns, flat top 0.18 ns, fall 0.06 ns, peak 100 A/m^2. Select Emission > pulsed_beam > Current pulse to change the pulse, and Velocity distribution to change the emitted normal-speed flux; click Apply, then Run. Old results are cleared when model settings change. Illustrative source/transport example, not a published benchmark.",
  "parameters": {
    "D": "15e-3",
    "R": "1.5e-3",
    "beam_energy": "1000",
    "run_end": "1.5e-9"
  },
  "boundaries": {
    "z_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "neumann",
      "voltage": "0",
      "particles": "reflect",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "neumann",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "2D-ZY",
    "solver": "electrostatic",
    "t_end": "run_end",
    "dt": "1e-12",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "D",
    "nz": "40",
    "y_min": "0",
    "y_max": "4*R",
    "ny": "24"
  },
  "diagnostics": {
    "output_dir": "output_source_designer_pulse_zy",
    "history_every": "1",
    "field_every": "50",
    "particle_every": "50",
    "max_dump_particles": "10000",
    "live_every": "20"
  },
  "parallel": {
    "mode": "serial",
    "ranks": 4,
    "threads": 1
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [
    {
      "name": "prescribed expanding pulse envelope",
      "enabled": true,
      "axis": "local 2D",
      "start": "0",
      "end": "1e-3",
      "region_shape": "polygon",
      "z0": "0",
      "z1": "1e-3",
      "y0": "0",
      "y1": "1e-3",
      "points": "0,0; D,0; D,3*R; .65*D,2.5*R; .25*D,1.6*R; 0,R",
      "buffer": ".4*R",
      "size": "R/8",
      "growth": "1.2"
    },
    {
      "name": "fine injection region",
      "enabled": true,
      "axis": "local 2D",
      "start": "0",
      "end": "1e-3",
      "region_shape": "rectangle",
      "z0": "0",
      "z1": "D/12",
      "y0": "0",
      "y1": "1.2*R",
      "points": "0,0; 1e-2,0; 1e-2,2e-3; 0,2e-4",
      "buffer": "R/5",
      "size": "R/12",
      "growth": "1.2"
    }
  ],
  "objects": [
    {
      "name": "drift region",
      "shape": "rectangle",
      "z0": "0",
      "z1": "D",
      "y0": "0",
      "y1": "4*R",
      "zc": "0",
      "yc": "0",
      "radius": "1e-3",
      "radius_inner": "5e-4",
      "a": "1e-3",
      "b": "1e-3",
      "points": "0,0; 1e-3,0; 0,1e-3",
      "expression": "z**2 + y**2 < 1e-6",
      "material": "vacuum",
      "voltage": "0",
      "eps_r": "1",
      "loss_spec": "Q",
      "Q": "250",
      "frequency": "5.8e9",
      "fill": "1",
      "cal_period": "",
      "cal_phase": "pi",
      "sigma": "1",
      "collect_charge": true
    }
  ],
  "species": [
    {
      "name": "electrons",
      "preset": "electron",
      "charge": "-1",
      "mass": "me",
      "beam_self_B": false,
      "motion": "full"
    }
  ],
  "loaders": [],
  "emitters": [
    {
      "name": "pulsed_beam",
      "species": "electrons",
      "model": "beam",
      "surface": "segment",
      "object": "",
      "z0": "0",
      "y0": "0",
      "z1": "0",
      "y1": "R",
      "normal": "+z",
      "current_density": "(100)*(min((t-(1e-10))/(6e-11),1,(((6e-11)+(1.8e-10)+(6e-11))-(t-(1e-10)))/(6e-11)))*where(((t-(1e-10))>=0)&((t-(1e-10))<((6e-11)+(1.8e-10)+(6e-11))),1,0)",
      "energy": "beam_energy",
      "temperature": "0",
      "work_function": "4.5",
      "beta": "1",
      "cathode_temperature": "2000",
      "richardson": "1.20173e6",
      "schottky": true,
      "relax": "1.0",
      "profile": "1",
      "particles_per_cell": "32",
      "t_start": "1e-10",
      "t_stop": "(1e-10)+((6e-11)+(1.8e-10)+(6e-11))",
      "velocity_distribution": "waterbag",
      "velocity_mean": "",
      "velocity_spread": "1e5",
      "velocity_min": "speed_eV(beam_energy)-2e5",
      "velocity_max": "speed_eV(beam_energy)+2e5",
      "velocity_plateau": "0.5",
      "velocity_pdf_0": "0, 0\n1e5, 1\n2e5, 1\n3e5, 0",
      "velocity_table_kind": "flux",
      "transverse_distribution": "waterbag",
      "transverse_width": [
        "2e5",
        "0"
      ],
      "velocity_pdf_1": "-100000, 0\n0, 1\n100000, 0",
      "velocity_pdf_2": "-100000, 0\n0, 1\n100000, 0",
      "velocity_version": "2",
      "pulse_builder": {
        "shape": "trapezoid",
        "start": "1e-10",
        "rise": "6e-11",
        "hold": "1.8e-10",
        "fall": "6e-11",
        "normalization": "peak",
        "amount": "100",
        "table_units": "seconds",
        "repeat": "1",
        "period": "",
        "generated_expression": "(100)*(min((t-(1e-10))/(6e-11),1,(((6e-11)+(1.8e-10)+(6e-11))-(t-(1e-10)))/(6e-11)))*where(((t-(1e-10))>=0)&((t-(1e-10))<((6e-11)+(1.8e-10)+(6e-11))),1,0)"
      }
    }
  ],
  "external_fields": [],
  "sources": [],
  "probes": [],
  "line_probes": [],
  "power_lines": []
}
