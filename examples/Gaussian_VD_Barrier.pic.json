{
  "version": 1,
  "name": "Half-Gaussian velocity flux into a space-charge barrier (1D)",
  "description": "Electrons are injected at 1e5 A/m^2 into a 15 mm gap with the collector at +100 V. This is far above the space-charge limit of the gap (Child-Langmuir 10.4 A/m^2 at 100 V; with the injection speeds, only a fraction can cross), so a potential minimum (virtual cathode / barrier) forms in front of the emitter and reflects most electrons. Injected normal speed: truncated Gaussian current flux with mean 0 and sigma 2e5 m/s (a half-Gaussian, v_n >= 0, kT-equivalent m sigma^2/e = 0.23 eV). The Velocity distribution dialog shows the transmission T(b) of a barrier b for this flux. J(t) is a constant 1e5 A/m^2 (square pulse longer than the run). Select Emission > pulsed_beam > Current pulse to change the pulse, and Velocity distribution to change the emitted normal-speed flux; click Apply, then Run. Old results are cleared when model settings change. Illustrative source/transport example, not a published benchmark.",
  "parameters": {
    "D": "15e-3",
    "V_collector": "100",
    "J_inj": "1e5"
  },
  "boundaries": {
    "z_min": {
      "name": "emitter",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "collector",
      "field": "conductor",
      "voltage": "V_collector",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
    "solver": "electrostatic",
    "t_end": "50e-9",
    "dt": "1e-12",
    "cfl": "0.95",
    "n_steps": "",
