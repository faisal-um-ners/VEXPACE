{
  "version": 1,
  "name": "Gaussian pulse: 2D RZ vacuum drift",
  "description": "Finite gaussian electron pulse drifting through a vacuum interior with no geometry objects, no applied fields, and grounded axial ends. Select Emission > pulsed_beam > Current pulse to change the shape or duration; click Apply, then Run. Old results are cleared when model settings change. This is an illustrative source/transport example, not a published benchmark. Current density is 10 A/m^2 in 1D and 100 A/m^2 in 2D. Pulse starts at 0.10 ns with full duration 0.30 ns; Gaussian FWHM is about 0.118 ns; each trapezoid ramp is 0.06 ns. The explicit pic_dt/2 source evaluation offset uses midpoint current sampling without changing the pusher. The simulation runs until 1.5 ns so the pulse can cross the 15 mm domain. The 2D mesh uses a prescribed beam-envelope polygon and a finer emitter rectangle, with buffer/growth transitions; the outlines control mesh resolution and do not constrain particles. Transverse motion is enabled. The lower transverse boundary is the RZ axis or a planar symmetry plane; the outer transverse boundary uses Neumann fields and absorbing particles.",
  "parameters": {
    "D": "10e-3",
    "beam_energy": "1000",
    "pic_dt": "1e-12",
    "run_end": "0.5e-9",
    "R": "0.1e-3"
  },
  "boundaries": {
    "z_min": {
      "name": "injection_plane",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "collector",
      "field": "conductor",
      "voltage": "10e3",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "axis",
      "voltage": "0",
      "particles": "reflect",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "neumann",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "2D-RZ",
    "solver": "electrostatic",
    "t_end": "run_end",
    "dt": "pic_dt",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "D",
    "nz": "40",
    "y_min": "0",
    "y_max": "5*R",
    "ny": "24"
  },
  "diagnostics": {
    "output_dir": "output_source_designer_pulse_rz",
    "history_every": "1",
    "field_every": "100",
    "particle_every": "100",
    "max_dump_particles": "10000",
    "live_every": "1"
  },
  "parallel": {
    "mode": "serial",
    "ranks": 4,
    "threads": 1
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [
    {
      "name": "prescribed expanding pulse envelope",
      "enabled": true,
      "axis": "local 2D",
      "start": "0",
      "end": "1e-3",
      "region_shape": "polygon",
      "z0": "0",
      "z1": "1e-3",
      "y0": "0",
      "y1": "1e-3",
      "points": "0,0; D,0; D,1.5*R; 0,1.5*R;",
      "buffer": ".4*R",
      "size": "R/5",
      "growth": "1.2"
    },
    {
      "name": "fine along injection region",
      "enabled": true,
      "axis": "local 2D",
      "start": "0",
      "end": "1e-3",
      "region_shape": "rectangle",
      "z0": "0",
      "z1": "D",
      "y0": "0",
      "y1": "R",
      "points": "0,0; 1e-2,0; 1e-2,2e-3; 0,2e-4",
      "buffer": "R/5",
      "size": "R/10",
      "growth": "1.2"
    },
    {
      "name": "emission region1",
      "enabled": true,
      "axis": "y",
      "start": "0",
      "end": "R",
      "region_shape": "rectangle",
      "z0": "0",
      "z1": "1e-3",
      "y0": "0",
      "y1": "1e-3",
      "points": "0,0; 1e-2,0; 1e-2,2e-3; 0,2e-4",
      "buffer": "0",
      "size": "1",
      "growth": "1.5"
    }
  ],
  "objects": [],
  "species": [
    {
      "name": "electrons",
      "preset": "electron",
      "charge": "-1",
      "mass": "me",
      "beam_self_B": false,
      "motion": "z_only"
    }
  ],
  "loaders": [],
  "emitters": [
    {
      "name": "pulsed_beam",
      "species": "electrons",
      "model": "beam",
      "surface": "segment",
      "object": "",
      "z0": "0",
      "y0": "0",
      "z1": "0",
      "y1": "R",
      "normal": "+z",
      "current_density": "((10000))*(1)*where((((t+(pic_dt/2)-(0.0))/(3e-12))>=0)&(((t+(pic_dt/2)-(0.0))/(3e-12))<1),1,0)",
      "energy": "0",
      "temperature": "0",
      "work_function": "4.5",
      "beta": "1",
      "cathode_temperature": "2000",
      "richardson": "1.20173e6",
      "schottky": true,
      "relax": "1.0",
      "profile": "1",
      "particles_per_cell": "64",
      "t_start": "(0.0)-(pic_dt/2)",
      "t_stop": "(0.0)+(3e-12)-(pic_dt/2)",
      "velocity_distribution": "maxwellian",
      "velocity_width": [
        "2e5",
        "2e5",
        "2e5"
      ],
      "velocity_plateau": "0.5",
      "velocity_pdf_0": "-100000, 0\n0, 1\n100000, 0",
      "velocity_pdf_1": "-100000, 0\n0, 1\n100000, 0",
      "velocity_pdf_2": "-100000, 0\n0, 1\n100000, 0",
      "pulse_builder": {
        "shape": "square",
        "start": "0.0",
        "duration": "3e-12",
        "normalization": "peak",
        "amount": "10000",
        "rise": "1.0000000000000002e-12",
        "cutoff": "3",
        "points": "0,0\n0.3,1\n0.7,0.5\n1,0",
        "sample_shift": "pic_dt/2",
        "generated_expression": "((10000))*(1)*where((((t+(pic_dt/2)-(0.0))/(3e-12))>=0)&(((t+(pic_dt/2)-(0.0))/(3e-12))<1),1,0)"
      }
    }
  ],
  "external_fields": [],
  "sources": [],
  "probes": [],
  "line_probes": [],
  "power_lines": []
}