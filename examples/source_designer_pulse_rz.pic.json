{
  "version": 1,
  "name": "Gaussian pulse: 2D RZ small-disk emitter",
  "description": "Gaussian electron pulse from a small disk (radius R = 0.1 mm) at the cathode of a 10 mm, 10 kV planar gap. Emission: Maxwellian (Rayleigh) current flux of a 0.2 eV cathode, P(v) ~ v exp(-mv^2/2kT), with thermal transverse velocities. J(t): FWHM 0.1 ns, +-3 sigma, peak 1e4 A/m^2 (below the planar Child-Langmuir value 2.3e4 A/m^2). The local triangle mesh is refined along the emission region and the expanding beam. Select Emission > pulsed_beam > Current pulse to change the pulse, and Velocity distribution to change the emitted normal-speed flux; click Apply, then Run. Old results are cleared when model settings change. Illustrative source/transport example, not a published benchmark.",
  "parameters": {
    "D": "10e-3",
    "R": "0.1e-3",
    "V0": "10e3",
    "run_end": "1.5e-9"
  },
  "boundaries": {
    "z_min": {
      "name": "cathode",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "anode",
      "field": "conductor",
      "voltage": "V0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "axis",
      "voltage": "0",
      "particles": "reflect",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "neumann",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "2D-RZ",
    "solver": "electrostatic",
    "t_end": "run_end",
    "dt": "1e-12",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "D",
    "nz": "40",
    "y_min": "0",
    "y_max": "20*R",
    "ny": "8"
