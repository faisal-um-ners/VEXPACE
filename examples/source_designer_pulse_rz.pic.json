    "field_every": "50",
    "particle_every": "50",
    "max_dump_particles": "10000",
    "live_every": "20"
  },
  "parallel": {
    "mode": "serial",
    "ranks": 4,
    "threads": 1
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [
    {
      "name": "prescribed expanding pulse envelope",
      "enabled": true,
      "axis": "local 2D",
      "start": "0",
      "end": "1e-3",
      "region_shape": "polygon",
      "z0": "0",
      "z1": "1e-3",
      "y0": "0",
      "y1": "1e-3",
      "points": "0,0; D,0; D,5*R; 0,1.5*R",
      "buffer": ".4*R",
      "size": "R/2",
      "growth": "1.2"
    },
    {
      "name": "fine along emission region",
      "enabled": true,
      "axis": "local 2D",
      "start": "0",
      "end": "1e-3",
      "region_shape": "rectangle",
      "z0": "0",
      "z1": "D/10",
      "y0": "0",
      "y1": "1.2*R",
      "points": "0,0; 1e-2,0; 1e-2,2e-3; 0,2e-4",
