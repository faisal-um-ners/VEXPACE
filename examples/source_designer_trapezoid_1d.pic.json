{
  "version": 1,
  "name": "Trapezoid pulse: 1D vacuum drift",
  "description": "Finite electron pulse drifting through a grounded 15 mm vacuum gap (no applied field). Trapezoid J(t): rise 0.06 ns, flat top 0.18 ns, fall 0.06 ns, peak 10 A/m^2. Normal speed: trapezoid flux on v_b-2e5 ... v_b+2e5 m/s with a 50 % plateau. Select Emission > pulsed_beam > Current pulse to change the pulse, and Velocity distribution to change the emitted normal-speed flux; click Apply, then Run. Old results are cleared when model settings change. Illustrative source/transport example, not a published benchmark.",
  "parameters": {
    "D": "15e-3",
    "beam_energy": "1000",
    "run_end": "1.5e-9"
  },
  "boundaries": {
    "z_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
