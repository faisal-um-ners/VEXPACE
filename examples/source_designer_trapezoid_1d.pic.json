  "domain": {
    "z_min": "0",
    "z_max": "D",
    "nz": "120",
    "y_min": "0",
    "y_max": "1e-2",
    "ny": "128"
  },
  "diagnostics": {
    "output_dir": "output_source_designer_trapezoid_1d",
