{
  "version": 1,
  "name": "Trapezoid pulse: 1D vacuum drift",
  "description": "Finite trapezoid electron pulse drifting through a vacuum interior with no geometry objects, no applied fields, and grounded axial ends. Select Emission > pulsed_beam > Current pulse to change the shape or duration; click Apply, then Run. Old results are cleared when model settings change. This is an illustrative source/transport example, not a published benchmark. Current density is 10 A/m^2 in 1D and 100 A/m^2 in 2D. Pulse starts at 0.10 ns with full duration 0.30 ns; Gaussian FWHM is about 0.118 ns; each trapezoid ramp is 0.06 ns. The explicit pic_dt/2 source evaluation offset uses midpoint current sampling without changing the pusher. The simulation runs until 1.5 ns so the pulse can cross the 15 mm domain. ",
  "parameters": {
    "D": "15e-3",
    "beam_energy": "1000",
    "pic_dt": "1e-12",
    "run_end": "1.5e-9"
  },
  "boundaries": {
    "z_min": {
      "name": "injection_plane",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "collector",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
    "solver": "electrostatic",
    "t_end": "run_end",
    "dt": "pic_dt",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "D",
    "nz": "120",
    "y_min": "0",
    "y_max": "1e-2",
    "ny": "128"
  },
  "diagnostics": {
    "output_dir": "output_source_designer_trapezoid_1d",
    "history_every": "1",
    "field_every": "50",
    "particle_every": "50",
    "max_dump_particles": "10000",
    "live_every": "20"
  },
  "parallel": {
    "mode": "serial",
    "ranks": 4,
    "threads": 1
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [],
  "objects": [],
  "species": [
    {
      "name": "electrons",
      "preset": "electron",
      "charge": "-1",
      "mass": "me",
      "beam_self_B": false,
      "motion": "full"
    }
  ],
  "loaders": [],
  "emitters": [
    {
      "name": "pulsed_beam",
      "species": "electrons",
      "model": "beam",
      "surface": "segment",
      "object": "",
      "z0": "0",
      "y0": "0",
      "z1": "0",
      "y1": "1e-3",
      "normal": "+z",
      "current_density": "((10))*(max(0,min(1,min(((t+(pic_dt/2)-(1e-10))/(3e-10)),1-((t+(pic_dt/2)-(1e-10))/(3e-10)))/(((6e-11)/(3e-10))))))*where((((t+(pic_dt/2)-(1e-10))/(3e-10))>=0)&(((t+(pic_dt/2)-(1e-10))/(3e-10))<1),1,0)",
      "energy": "beam_energy",
      "temperature": "0",
      "work_function": "4.5",
      "beta": "1",
      "cathode_temperature": "2000",
      "richardson": "1.20173e6",
      "schottky": true,
      "relax": "1.0",
      "profile": "1",
      "particles_per_cell": "8",
      "t_start": "(1e-10)-(pic_dt/2)",
      "t_stop": "(1e-10)+(3e-10)-(pic_dt/2)",
      "velocity_distribution": "trapezoid",
      "velocity_width": [
        "2e5",
        "0",
        "0"
      ],
      "velocity_plateau": "0.5",
      "velocity_pdf_0": "-100000, 0\n0, 1\n100000, 0",
      "velocity_pdf_1": "-100000, 0\n0, 1\n100000, 0",
      "velocity_pdf_2": "-100000, 0\n0, 1\n100000, 0",
      "pulse_builder": {
        "shape": "trapezoid",
        "start": "1e-10",
        "duration": "3e-10",
        "normalization": "peak",
        "amount": "10",
        "rise": "6e-11",
        "cutoff": "3",
        "points": "0,0\n0.3,1\n0.7,0.5\n1,0",
        "sample_shift": "pic_dt/2",
        "generated_expression": "((10))*(max(0,min(1,min(((t+(pic_dt/2)-(1e-10))/(3e-10)),1-((t+(pic_dt/2)-(1e-10))/(3e-10)))/(((6e-11)/(3e-10))))))*where((((t+(pic_dt/2)-(1e-10))/(3e-10))>=0)&(((t+(pic_dt/2)-(1e-10))/(3e-10))<1),1,0)"
      }
    }
  ],
  "external_fields": [],
  "sources": [],
  "probes": [],
  "line_probes": [],
  "power_lines": []
}